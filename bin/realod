#!/usr/bin/env php
<?php

require __DIR__ . "/../../../autoload.php";

use Websyspro\DevTools\EventReload;
use Websyspro\DevTools\Watching;

$watching = new Watching();
$watching->on( EventReload::class );
$watching->listen();

$router = __DIR__ . '/../websyspro/devtools/RouteEntryPoint.php';

passthru( sprintf(
  'php -S %s:%d %s',
  $host,
  $port,
  escapeshellarg($router)
));